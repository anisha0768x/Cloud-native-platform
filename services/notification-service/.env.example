SERVICE_NAME=notification-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8009

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/notification_service

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

# All three channels below are OPTIONAL — leave any blank to skip it.
# A notification with zero channels configured still records (with zero
# delivery attempts) rather than failing.
WEBHOOK_URL=
SLACK_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=25
SMTP_FROM_ADDRESS=alerts@platform.local
SMTP_TO_ADDRESSES=[]
SMTP_USE_TLS=false

CHANNEL_TIMEOUT_SECONDS=5.0

ESCALATION_WINDOW_MINUTES=15
ESCALATION_WORKER_POLL_SECONDS=60
ENABLE_ESCALATION_WORKER=true

ALLOWED_ORIGINS=["http://localhost:5173"]
