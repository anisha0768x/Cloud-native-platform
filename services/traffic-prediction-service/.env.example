SERVICE_NAME=traffic-prediction-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8006

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/traffic_prediction_service

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

METRICS_SERVICE_URL=http://localhost:8003

# 21 days of hourly history — enough to capture weekly seasonality (the
# lag_168h feature needs at least a week; more gives the model more to learn from).
LOOKBACK_HOURS=504
# Below this many real data points from Metrics Service, fall back to
# synthetic training data.
MIN_TRAINING_POINTS=48

REQUESTS_PER_POD_CAPACITY=200
MODEL_CACHE_TTL_SECONDS=3600

ALLOWED_ORIGINS=["http://localhost:5173"]
