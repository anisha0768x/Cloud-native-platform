SERVICE_NAME=k8s-management-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8004

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/k8s_management_service

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

# "demo": synthetic-but-consistent cluster data, no real cluster needed.
# "kubernetes": real cluster via in-cluster ServiceAccount or ~/.kube/config.
CLUSTER_MODE=demo

SNAPSHOT_INTERVAL_SECONDS=30
ENABLE_SNAPSHOT_WORKER=true

ALLOWED_ORIGINS=["http://localhost:5173"]
