SERVICE_NAME=genai-log-analysis-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8008

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/genai_log_analysis_service

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

REDIS_URL=redis://localhost:6379/0

# "memory": no external dependency, fine for local dev.
# "opensearch": real deployment, matches infra/docker-compose.yml.
LOG_STORE_MODE=memory
OPENSEARCH_HOSTS=["http://localhost:9200"]

METRICS_SERVICE_URL=http://localhost:8003

# Leave blank to run in fallback-only mode (a supported, tested
# configuration) — set to a real key to enable actual Claude analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=8.0

ANALYSIS_CACHE_TTL_SECONDS=600
RECENT_ERROR_LOG_LIMIT=20

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LOGS_TOPIC=logs.raw
KAFKA_CONSUMER_GROUP=genai-log-analysis-service
ENABLE_KAFKA_CONSUMER=false

ALLOWED_ORIGINS=["http://localhost:5173"]
