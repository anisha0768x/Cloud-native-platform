# Copy to .env and fill in. Keys are generated via: python scripts/generate_keys.py

SERVICE_NAME=auth-service
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8001

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/auth_service

# Paste contents of keys/private_key.pem and keys/public_key.pem below
# (as single-line strings with \n, or load via a secrets manager in real envs)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800

ALLOWED_ORIGINS=["http://localhost:5173"]
