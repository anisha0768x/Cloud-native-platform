SERVICE_NAME=metrics-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8003

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/metrics_service

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
METRICS_TOPIC=metrics.raw
KAFKA_CONSUMER_GROUP=metrics-service
ENABLE_KAFKA_CONSUMER=true

MAX_QUERY_RANGE_DAYS=90

ALLOWED_ORIGINS=["http://localhost:5173"]
