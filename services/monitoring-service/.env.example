SERVICE_NAME=monitoring-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8002

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/monitoring_service

# Only the PUBLIC key is ever needed here.
JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

CONSECUTIVE_FAILURES_BEFORE_DOWN=3
HEALTH_SUMMARY_WINDOW_SIZE=100

ALLOWED_ORIGINS=["http://localhost:5173"]
