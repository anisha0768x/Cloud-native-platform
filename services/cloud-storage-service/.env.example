SERVICE_NAME=cloud-storage-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8010

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

# Points at MinIO (infra/docker-compose.yml) for local dev — MinIO speaks
# the S3 API, so this exact same provider code targets real AWS S3 in
# production by just unsetting S3_ENDPOINT_URL.
S3_BUCKET=platform-storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=platform
S3_SECRET_KEY=platform_local_dev_only
S3_REGION=us-east-1

MAX_UPLOAD_SIZE_BYTES=52428800
PRESIGNED_URL_EXPIRY_SECONDS=3600

ALLOWED_ORIGINS=["http://localhost:5173"]
