SERVICE_NAME=predictive-maintenance-service
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8007

DATABASE_URL=postgresql+asyncpg://platform:platform_local_dev_only@localhost:5432/predictive_maintenance_service

JWT_PUBLIC_KEY_PATH=../auth-service/keys/public_key.pem

METRICS_SERVICE_URL=http://localhost:8003
K8S_MANAGEMENT_SERVICE_URL=http://localhost:8004

# Window for computing CPU/memory mean/std/slope trend features.
FEATURE_LOOKBACK_HOURS=6

# Training data is ALWAYS synthetic for this service (see app/ml/synthetic.py
# docstring for why) — this just controls how many synthetic examples.
TRAINING_SAMPLE_COUNT=2000
MODEL_CACHE_TTL_SECONDS=3600

ALLOWED_ORIGINS=["http://localhost:5173"]
